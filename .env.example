# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Project Settings → API) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key — safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service_role) key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Verified emails that become owner admins on first sign-in (comma-separated).
ADMIN_BOOTSTRAP_EMAILS=you@yourdomain.com

# ─── Stripe (Developers → API keys / Webhooks) ─────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Jennings Media <bookings@yourdomain.com>"
# Where new-booking / lead alerts go (also editable in Admin → Settings).
ADMIN_NOTIFICATION_EMAILS=you@yourdomain.com

# ─── Scheduled jobs (Vercel Cron sends this as a Bearer token) ──────────
CRON_SECRET=generate-a-long-random-string

# ─── Optional ─────────────────────────────────────────────────────────────
# Better geocoding for travel fees (falls back to the free U.S. Census geocoder).
GOOGLE_MAPS_API_KEY=
# Analytics (can also be set in Admin → Settings → Integrations).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
# SMS reminders (dormant until all three are set and SMS is enabled in settings).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Show is_sample portfolio/testimonials in production (default: dev only).
SHOW_SAMPLE_CONTENT=false
# Optional: showreel film (YouTube/Vimeo or .mp4) and public contact email
NEXT_PUBLIC_SHOWREEL_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Stripe customer portal login link (clients manage their retainer)
NEXT_PUBLIC_STRIPE_PORTAL_URL=
